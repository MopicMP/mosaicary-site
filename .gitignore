# То же, что про сайт сказано в корневом .gitignore, но путями от этой папки —
# чтобы правило уехало вместе с ней в отдельный репозиторий. Без него в чужую
# копию первым же `git add .` попадает `.dev.vars` с живым секретом.

# Сборка и зависимости.
node_modules/
dist/

# База, которую wrangler держит на диске при местной работе, и всё остальное его
# хозяйство: локальные D1 и R2. Это настоящие данные одной машины, а не сайт.
.data/
.wrangler/

# Секреты. Любой .env и .dev.vars, кроме примера, который для того и лежит.
.env
.env.*
.dev.vars
!.env.example

# Вывод проверок руками: журналы запуска и снимки экрана.
boot.log
boot.err
.shots/

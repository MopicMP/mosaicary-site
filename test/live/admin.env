# Who runs the site, while the live check is running.
#
# ADMINS normally holds a real person's provider id and lives in ../.env, which is not
# in the repository. The live check needs somebody to be an admin and must not read or
# print that line, so this file names a local test identity instead and is loaded after
# ../.env, which overrides it:
#
#   wrangler dev --local --port 8787 --env-file ../.env --env-file test/live/admin.env \
#     --var PUBLIC_ORIGIN:http://localhost:5173
#
# Nothing here is secret: the account with this identity exists only in the local
# database kept under .wrangler/state.
ADMINS=discord:admin-subject

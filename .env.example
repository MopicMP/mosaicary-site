# Скопируй в .env для местной работы. На Railway то же самое задаётся переменными
# сервиса. Файл .env в git не попадает — см. .gitignore в корне.

# Railway подставляет свой; локально можно любой свободный.
PORT=3000

# info в бою, debug когда что-то непонятно.
LOG_LEVEL=info

# --- база ---

# Пусто — работает встроенный Postgres прямо в процессе, база лежит в site/.data/db.
# Ничего ставить не надо, диалект тот же самый. На Railway сюда идёт плагин:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- вход через Discord ---

# Заводится на discord.com/developers/applications → New Application.
# Что именно взять и куда вписать — в docs/site.md, раздел «Приложение в Discord».
# Redirect URI должен совпасть с точностью до символа, включая https и хвост.
# Пока эти три пусты, кнопка «Войти» честно говорит, что вход не настроен.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://твой-домен/api/auth/discord/callback

# Чем подписываются сессии и токены мода. Длинная случайная строка, от 16 символов.
# Взять, например, так:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Меняешь — все выходят из аккаунтов и все привязки игры отваливаются.
# В бою (NODE_ENV=production) без неё сервер не запустится — и это нарочно.
# SESSION_SECRET=

# S3-совместимое хранилище Railway под сами картинки.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
